// Spinr data model — Phase 2 (accounts + studio).
// Postgres (Neon/Supabase). Legacy pre-pivot models removed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  name               String?
  image              String?
  createdAt          DateTime            @default(now())
  spins              Spin[]
  shopifyConnections ShopifyConnection[]
}

// Phase 4: a merchant's Shopify store connected to their Spinr account.
// Connection, NOT a login method. accessToken is an offline Admin API token
// obtained via OAuth (authorization code grant).
model ShopifyConnection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Canonical myshopify.com domain, e.g. kokok.myshopify.com.
  // Unique: one Spinr account per shop.
  shop        String   @unique
  shopName    String?
  // ⚠️ Plaintext for beta — encrypt at rest before public launch
  // (pre-launch checklist).
  accessToken String
  scope       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Spin {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String   @default("Untitled product")
  // draft (photos uploaded) | generating | ready | failed
  status        String   @default("draft")
  // Background-removed photo URLs (fal.media)
  photoFrontUrl String?
  photoBackUrl  String?
  photoLeftUrl  String?
  photoRightUrl String?
  // Async generation (Phase 3): fal queue request id the webhook/poll
  // reconciles against, and when the job was submitted.
  falRequestId      String?
  generateStartedAt DateTime?
  // Shopify catalog linkage (Phase 4): which product this spin was imported
  // from, and when its embed was last pushed back (custom.spinr_id metafield).
  shopifyProductGid    String?
  shopifyProductHandle String?
  pushedToShopifyAt    DateTime?
  // Generation result
  videoUrl      String?
  frameUrls     Json?
  modelUsed     String?
  durationMs    Int?
  errorMessage  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([falRequestId])
}
